# Copy this to .env and fill in what you have. All of these are optional -
# the app runs fine without them, RFQ sending just stays in "drafts only"
# mode until SMTP is configured.

# SMTP - required only for actually sending RFQ emails to suppliers.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Optional: comma-separated keywords a fetched eTenders tender must contain
# (title/description/category) to be imported. Defaults to concrete/civil
# terms; "*" imports everything.
TENDER_KEYWORDS=
